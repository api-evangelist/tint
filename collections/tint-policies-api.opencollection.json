        {
          "info": {
            "name": "Retrieve an endorsement.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tint.ai/v2/policy/:policyId/endorsement/:id",
            "params": [
              {
                "name": "policyId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an endorsement."
