{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tint Claims Questionnaires API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Questionnaires",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a questionnaire definition attached to a policy.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tint.ai/v2/policy/:policyId/questionnaire/:slug",
            "params": [
              {
                "name": "policyId",
                "value": "",
                "type": "path"
              },
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a questionnaire definition attached to a policy."
        }
      ]
    }
  ],
  "bundled": true
}