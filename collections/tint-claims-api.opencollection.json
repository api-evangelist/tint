            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tint.ai/v2/policy/:policyId/claim",
            "params": [
              {
                "name": "policyId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create a claim (first notice of loss) on a policy."
        },
